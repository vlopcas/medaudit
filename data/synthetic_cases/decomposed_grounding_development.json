    {
      "id": "ground-dev-009", "expected": {"valid": false, "category": "duplicate_step_support", "error": "claim contains duplicate step supports"},
      "response": {"status": "answered", "claims": [{"text": "Suporte repetido.", "supports": [{"step_id": "comparison-1", "evidence_ids": ["alpha-c1"]}, {"step_id": "comparison-1", "evidence_ids": ["alpha-c1"]}, {"step_id": "comparison-2", "evidence_ids": ["beta-c1"]}]}]}
    },
