        {"text": "Alfa possui regra sintética.", "supports": [{"step_id": "comparison-1", "evidence_ids": ["alpha-c1"]}]},
        {"text": "Beta possui regra sintética.", "supports": [{"step_id": "comparison-2", "evidence_ids": ["beta-c1"]}]}
      ]}
    },
    {
      "id": "ground-dev-002", "expected": {"valid": true, "category": "valid_cross_group_claim"},
