      "case_id": "initial-publication",
      "version": 1,
      "current": {
        "entities": [{"entity_id": "PROC-A", "entity_type": "procedure"}, {"entity_id": "RULE-A", "entity_type": "rule"}],
        "edges": [{"source_id": "PROC-A", "relation": "regulated_by", "target_id": "RULE-A", "document_id": "pub-a", "chunk_id": "pub-edge-a"}]
      },
      "expected": {"status": "published", "code": "published", "affected_count": 0, "published_version": 1}
    },
    {
      "case_id": "catalog-not-admitted",
      "version": 1,
      "current": {
        "entities": [{"entity_id": "ITEM-A", "entity_type": "item", "aliases": ["ALFA"]}, {"entity_id": "ITEM-B", "entity_type": "item", "aliases": ["alfa"]}],
        "edges": []
      },
      "expected": {"status": "review", "code": "catalog_not_admitted", "affected_count": 0, "published_version": null}
    },
    {
      "case_id": "invalid-initial-version",
      "version": 2,
      "current": {
        "entities": [{"entity_id": "PROC-A", "entity_type": "procedure"}, {"entity_id": "RULE-A", "entity_type": "rule"}],
        "edges": [{"source_id": "PROC-A", "relation": "regulated_by", "target_id": "RULE-A", "document_id": "pub-a", "chunk_id": "pub-edge-a"}]
      },
