      "current": {
        "entities": [{"entity_id": "PROC-A", "entity_type": "procedure"}, {"entity_id": "RULE-A", "entity_type": "rule"}, {"entity_id": "COND-A", "entity_type": "condition"}],
        "edges": [{"source_id": "PROC-A", "relation": "regulated_by", "target_id": "RULE-A", "document_id": "pub-a", "chunk_id": "pub-edge-a"}, {"source_id": "RULE-A", "relation": "requires", "target_id": "COND-A", "document_id": "pub-b", "chunk_id": "pub-edge-b"}]
      },
      "expected": {"status": "published", "code": "published", "affected_count": 0, "published_version": 2}
