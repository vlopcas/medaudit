    {
      "case_id": "stale-change-review",
      "version": 2,
      "previous": {
        "entities": [{"entity_id": "PROC-A", "entity_type": "procedure"}, {"entity_id": "RULE-A", "entity_type": "rule"}],
        "edges": [{"source_id": "PROC-A", "relation": "regulated_by", "target_id": "RULE-A", "document_id": "pub-a", "chunk_id": "pub-edge-a"}]
      },
      "current": {
        "entities": [{"entity_id": "PROC-A", "entity_type": "procedure"}, {"entity_id": "RULE-A", "entity_type": "rule"}],
        "edges": [{"source_id": "PROC-A", "relation": "regulated_by", "target_id": "RULE-A", "document_id": "pub-a", "chunk_id": "pub-edge-a"}]
      },
      "reviewed_changes": ["entity:STALE"],
      "review_snapshot": "previous",
      "expected": {"status": "error", "code": "invalid_review", "affected_count": 0, "published_version": null}
