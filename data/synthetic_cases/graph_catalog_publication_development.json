        "edges": [{"source_id": "PROC-A", "relation": "regulated_by", "target_id": "RULE-A", "document_id": "pub-a", "chunk_id": "pub-edge-a"}]
      },
      "expected": {"status": "review", "code": "destructive_change_review_required", "affected_count": 1, "published_version": null}
    },
    {
      "case_id": "provenance-mutation-pending",
      "version": 2,
      "previous": {
        "entities": [{"entity_id": "PROC-A", "entity_type": "procedure"}, {"entity_id": "RULE-A", "entity_type": "rule"}],
