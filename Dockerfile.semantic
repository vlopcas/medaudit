FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Keep the large ML runtime independent from ordinary source-code changes.
RUN python -m pip install "sentence-transformers>=5,<6"

COPY pyproject.toml README.md LICENSE ./
COPY src ./src

RUN python -m pip install --no-deps . \
    && groupadd --gid 10001 medaudit \
    && useradd --uid 10001 --gid medaudit --no-create-home medaudit \
    && chown -R medaudit:medaudit /app

USER medaudit
